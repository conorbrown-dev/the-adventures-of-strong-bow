{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mollys-learning-game.local/schemas/lesson-plan.schema.json",
  "title": "Multi-day Lesson Plan Sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "grade", "subject", "unitId", "title", "summary", "standardIds", "materials", "days", "accessibility", "provenance", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "grade": { "enum": ["K", "1", "2"] },
    "subject": { "enum": ["math", "ela"] },
    "unitId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "standardIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "alternatives"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "alternatives": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/day" }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioSupported", "requiresColor", "reducedMotionSafe", "accommodationNotes"],
      "properties": {
        "audioSupported": { "const": true },
        "requiresColor": { "const": false },
        "reducedMotionSafe": { "type": "boolean" },
        "accommodationNotes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license"],
      "properties": {
        "origin": { "const": "original" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "validated", "reviewed", "retired"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "directions"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "directions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "independentPractice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes", "directions", "templateIds", "itemCount"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1, "maximum": 30 },
        "directions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "templateIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "itemCount": { "type": "integer", "minimum": 3, "maximum": 10 }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "title", "objective", "standardIds", "adultSetup", "textRecommendation", "warmUp", "explicitModel", "guidedPractice", "independentPractice", "extension", "reteach", "masteryEvidence"],
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "standardIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "adultSetup": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "textRecommendation": { "type": "string", "minLength": 1 },
        "warmUp": { "$ref": "#/$defs/activity" },
        "explicitModel": { "$ref": "#/$defs/activity" },
        "guidedPractice": { "$ref": "#/$defs/activity" },
        "independentPractice": { "$ref": "#/$defs/independentPractice" },
        "extension": { "$ref": "#/$defs/activity" },
        "reteach": { "$ref": "#/$defs/activity" },
        "masteryEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
