{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mollys-learning-game.local/schemas/question-template.schema.json",
  "title": "Question Template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "primaryStandardId",
    "supportingStandardIds",
    "subject",
    "grade",
    "responseType",
    "prompt",
    "generator",
    "difficulty",
    "gameModes",
    "modalities",
    "provenance",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "primaryStandardId": {
      "type": "string"
    },
    "supportingStandardIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "subject": {
      "enum": [
        "math",
        "ela"
      ]
    },
    "grade": {
      "enum": [
        "K",
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    "responseType": {
      "enum": [
        "singleChoice",
        "multipleChoice",
        "numericInput",
        "textInput",
        "sequence",
        "classification",
        "matching",
        "pointSelection",
        "constructedResponse"
      ]
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audioText": {
          "type": [
            "string",
            "null"
          ]
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "kind",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "answerSpec": {
      "type": [
        "object",
        "null"
      ]
    },
    "distractorStrategy": {
      "type": [
        "object",
        "null"
      ]
    },
    "difficulty": {
      "type": "object",
      "required": [
        "band"
      ],
      "additionalProperties": false,
      "properties": {
        "band": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "dimensions": {
          "type": "object"
        }
      }
    },
    "gameModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fossilDigging",
          "dragonAdventure",
          "spaceShooter",
          "storyBoss"
        ]
      }
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresReading",
        "audioSupported",
        "visualSupported"
      ],
      "properties": {
        "requiresReading": {
          "type": "boolean"
        },
        "audioSupported": {
          "type": "boolean"
        },
        "visualSupported": {
          "type": "boolean"
        }
      }
    },
    "diagnosticEligible": {
      "type": "boolean",
      "default": false
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "license"
      ],
      "properties": {
        "origin": {
          "enum": [
            "original",
            "adapted",
            "copied",
            "aiDraft"
          ]
        },
        "sourceTitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatorProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatorModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "generatorPromptVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "validated",
            "reviewed",
            "retired"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
