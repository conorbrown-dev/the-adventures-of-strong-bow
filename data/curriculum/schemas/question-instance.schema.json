{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mollys-learning-game.local/schemas/question-instance.schema.json",
  "title": "Generated Question Instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "templateId",
    "templateVersion",
    "seed",
    "standardIds",
    "responseType",
    "prompt",
    "interaction",
    "canonicalAnswer",
    "explanation",
    "accessibility",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string"
    },
    "templateId": {
      "type": "string"
    },
    "templateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": [
        "integer",
        "string"
      ]
    },
    "standardIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "responseType": {
      "type": "string"
    },
    "prompt": {
      "type": "object"
    },
    "interaction": {
      "type": "object"
    },
    "canonicalAnswer": {},
    "answerNormalization": {
      "type": [
        "object",
        "null"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spokenPrompt",
        "textAlternative"
      ],
      "properties": {
        "spokenPrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "textAlternative": {
          "type": "string"
        },
        "reducedMotionSafe": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object"
    }
  }
}
