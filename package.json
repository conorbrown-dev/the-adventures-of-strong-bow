{
  "name": "molly-learning-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "map:export": "node scripts/export-farm-map.mjs",
    "map:split-atlas": "node scripts/split-terrain-atlas.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "curriculum:download": "npm run curriculum:validate",
    "curriculum:validate": "npm --prefix server run curriculum:validate",
    "curriculum:validate-templates": "npm --prefix server run curriculum:validate-templates",
    "curriculum:content:validate": "npm --prefix server run curriculum:content:validate",
    "curriculum:content:coverage": "npm --prefix server run curriculum:content:coverage",
    "curriculum:content:review-packet": "npm --prefix server run curriculum:content:review-packet",
    "curriculum:content:approve": "npm --prefix server run curriculum:content:approve",
    "curriculum:content:return-draft": "npm --prefix server run curriculum:content:return-draft",
    "curriculum:content:retire": "npm --prefix server run curriculum:content:retire",
    "curriculum:lesson-plans:validate": "npm --prefix server run curriculum:lesson-plans:validate",
    "curriculum:lesson-plans:review-packet": "npm --prefix server run curriculum:lesson-plans:review-packet",
    "curriculum:lesson-plans:approve": "npm --prefix server run curriculum:lesson-plans:approve",
    "curriculum:lesson-plans:return-draft": "npm --prefix server run curriculum:lesson-plans:return-draft",
    "curriculum:lesson-plans:retire": "npm --prefix server run curriculum:lesson-plans:retire",
    "curriculum:questions:validate": "npm --prefix server run curriculum:questions:validate",
    "curriculum:questions:generate": "npm --prefix server run curriculum:questions:generate",
    "curriculum:questions:coverage": "npm --prefix server run curriculum:questions:coverage",
    "test:curriculum:questions": "npm --prefix server run test:curriculum:questions",
    "test:curriculum:progress": "npm --prefix server run test:curriculum:progress",
    "curriculum:diagnostic": "npm --prefix server run curriculum:diagnostic",
    "curriculum:mastery:recalculate": "npm --prefix server run curriculum:mastery:recalculate",
    "curriculum:review:due": "npm --prefix server run curriculum:review:due",
    "curriculum:session:plan": "npm --prefix server run curriculum:session:plan",
    "curriculum:import": "npm --prefix server run curriculum:import",
    "curriculum:coverage": "npm --prefix server run curriculum:coverage",
    "curriculum:kindergarten:simulate": "npm --prefix server run curriculum:kindergarten:simulate",
    "test:curriculum": "npm --prefix server run test:curriculum",
    "start": "node server.mjs",
    "start:api": "npm --prefix server run start",
    "start:production": "node production.mjs"
  },
  "dependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "lucide": "^1.16.0",
    "phaser": "^3.80.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.7"
  }
}
