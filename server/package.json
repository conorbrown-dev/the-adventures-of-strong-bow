{
  "name": "mollys-learning-academy-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:curriculum": "jest --runInBand curriculum",
    "curriculum:validate": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js validate",
    "curriculum:validate-templates": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js validate-templates",
    "curriculum:content:validate": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js content:validate",
    "curriculum:content:coverage": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js content:coverage",
    "curriculum:content:review-packet": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js content:review-packet",
    "curriculum:content:approve": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js content:approve",
    "curriculum:content:return-draft": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js content:return-draft",
    "curriculum:content:retire": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js content:retire",
    "curriculum:questions:validate": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js questions:validate",
    "curriculum:questions:generate": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js questions:generate",
    "curriculum:questions:coverage": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js questions:coverage",
    "test:curriculum:questions": "jest --runInBand question-generator",
    "test:curriculum:progress": "jest --runInBand progress",
    "curriculum:diagnostic": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js diagnostic",
    "curriculum:mastery:recalculate": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js mastery:recalculate",
    "curriculum:review:due": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js review:due",
    "curriculum:session:plan": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js session:plan",
    "curriculum:import": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js import",
    "curriculum:coverage": "npm run build && node dist/curriculum/infrastructure/cli/curriculum.js report",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
