generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WordAttemptStatus {
  NotAttempted
  InProgress
  Mastered
}

enum GradeLevel {
  K
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
}

enum CurriculumSubject {
  ELA
  MATH
}

model GameMode {
  id          String @id @default(cuid())
  title       String
  slug        String @unique
  description String
  metadata    Json   @default("{}")
}

model Student {
  id               String @id @default(cuid())
  username         String @unique
  pin              String
  grade            GradeLevel @default(K)
  assignedSubjects CurriculumSubject[] @default([])
  createdAt        DateTime @default(now())

  wordAttempts WordAttempt[]
  quizAttempts QuizAttempt[]
}

model WordAttempt {
  id                 String            @id @default(cuid())
  studentId          String
  attemptCount       Int
  status             WordAttemptStatus @default(NotAttempted)
  wordText           String
  averageAttemptInMs Int

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, wordText])
}

model QuizAttempt {
  id             String            @id @default(cuid())
  studentId      String
  subject        CurriculumSubject
  grade          GradeLevel
  standardCode   String
  quizId         String
  correctAnswers Int
  questionCount  Int
  durationMs     Int
  completedAt    DateTime          @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, subject, grade])
}

model CurriculumStandard {
  officialId               String   @id
  canonicalId              String   @unique
  subject                  String
  grade                    String
  gradeName                String
  domainCode               String
  domain                   String
  strand                   String?
  clusterCode              String?
  parentId                 String?
  sourceItem               String?
  statement                String
  childFriendlyDescription String?
  isLeaf                   Boolean
  instructionalStatus      String
  prerequisiteIds          Json     @default("[]")
  tags                     Json     @default("[]")
  source                   Json
  license                  Json
  active                   Boolean
  importedAt               DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([subject, grade, domainCode])
  @@index([active, instructionalStatus])
}

model CurriculumAttemptEvent {
  id                    String   @id
  learnerId             String
  sessionId             String
  questionInstanceId    String
  templateId            String
  templateVersion       Int
  primaryStandardId     String
  supportingStandardIds Json     @default("[]")
  submittedAnswer       Json
  correct               Boolean
  usedHint              Boolean
  independent           Boolean
  purpose               String
  deliveryContext       String?
  responseDurationMs    Int?
  responseType          String
  attemptedAt           DateTime

  @@index([learnerId, primaryStandardId, attemptedAt])
}

model CurriculumMasteryRecord {
  learnerId         String
  standardId        String
  state             String
  scoredAttemptCount Int
  masteryAchievedAt DateTime?
  reviewStage       Int?
  nextReviewAt      DateTime?
  updatedAt         DateTime

  @@id([learnerId, standardId])
  @@index([learnerId, state, nextReviewAt])
}

model CurriculumLearningTarget {
  learnerId  String
  standardId String
  active     Boolean

  @@id([learnerId, standardId])
}

model CurriculumPrerequisiteLink {
  standardId             String
  prerequisiteStandardId String
  source                 String
  reviewed               Boolean

  @@id([standardId, prerequisiteStandardId])
}

model CurriculumDiagnosticPlacement {
  id                String   @id @default(cuid())
  learnerId         String
  grouping          String
  grade             String
  learningTargetIds Json     @default("[]")
  completedAt       DateTime

  @@index([learnerId, grouping, completedAt])
}
